# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://freshour:freshour@localhost:5432/freshour?schema=public"

# Secret used to sign session cookies (32+ random bytes, base64 or hex).
# Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"

# Session cookie lifetime, in seconds. Default: 8 hours.
SESSION_TTL_SECONDS=28800

# Base URL used to build public quote links (/q/:token).
APP_BASE_URL="http://localhost:3000"
